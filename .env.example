# Copy to backend/.env (never commit the real file).

# SQLite file used by the API and CLI.
DATABASE_URL=sqlite:///./vip_pulse.db

# LLM provider: "fake" (offline, deterministic) or "gemini".
LLM_PROVIDER=fake
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# USD per 1M tokens for GEMINI_MODEL (paid tier; change together with the model).
GEMINI_PRICE_INPUT_PER_M=0.30
GEMINI_PRICE_OUTPUT_PER_M=2.50
GEMINI_MAX_OUTPUT_TOKENS=2048
GEMINI_THINKING_BUDGET=0

# Hard cap on total paid LLM spend, across all runs recorded in the database.
LLM_BUDGET_USD=1.0
# Parallel LLM calls per triage run (lower it on the free tier).
LLM_CONCURRENCY=4

# Policy thresholds file (SLA / priority rules).
POLICY_PATH=app/policy/thresholds.yaml
